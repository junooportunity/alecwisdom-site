                <div class="monos-image-label" style="margin-top: 0; margin-bottom: 0; text-align: center;">Phi Interface</div>
                <hr class="monos-divider" style="margin-top: 1rem; margin-bottom: 0.75rem;">
                <div class="monos-image-container" style="margin-top: 0; padding: 0 5rem;">
                    <img src="Images/Images/Stills/MPM/Phi UI Interface.webp" alt="Phi Interface" class="monos-image" style="width: 100%; max-width: 500px; border-radius: 12px; overflow: hidden;">
                </div>
                <hr class="monos-divider" style="margin-top: 1rem; margin-bottom: 1rem;">
                <div class="monos-image-label" style="margin-top: 0; margin-bottom: 0; text-align: center;">Helix Interface</div>
                <hr class="monos-divider" style="margin-top: 1rem; margin-bottom: 1rem;">
                <div class="monos-image-container" style="margin-top: 0; padding: 0 5rem;">
                    <img src="Images/Images/Stills/MPM/Helix UI Interface.webp" alt="Helix Interface" class="monos-image" style="width: 100%; max-width: 500px; border-radius: 8px;">
                </div>
                <hr class="monos-divider" style="margin-top: 2rem; margin-bottom: 1.5rem;">
                <div style="text-align: center; margin: 0 auto 1.5rem auto;">
                    <a href="https://buy.stripe.com/your-checkout-link" target="_blank" class="lg-pill">Buy</a>
                </div>
                </div>
            </div>
        </div>
        <hr class="monos-divider monos-footer-divider" style="margin-top: 0; margin-bottom: 0.5rem;">
            <div class="monos-copyright">© 2026 Monos Pros Monon</div>
        </div>
    </div>
    <script>
        // Scroll to top smoothly when page loads (for when loaded in iframe)
        function scrollToTopSmooth() {
            window.scrollTo({
                top: 0,
                left: 0,
                behavior: 'smooth'
            });
            if (document.documentElement) {
                document.documentElement.scrollTop = 0;
            }
            if (document.body) {
                document.body.scrollTop = 0;
            }
        }
        
        window.addEventListener('load', function() {
            scrollToTopSmooth();
        });
        
        // Also scroll to top immediately if already loaded
        if (document.readyState === 'complete') {
            scrollToTopSmooth();
        } else {
            document.addEventListener('DOMContentLoaded', function() {
                scrollToTopSmooth();
            });
        }

        // Unified accordion toggle functionality (Archive, Plugins, Applications)
        // Each accordion works independently - multiple panels can be open at once
        (function() {
            // Function to toggle a specific accordion panel
            const toggleAccordion = (toggleElement, e) => {
                if (e) {
                    e.preventDefault();
                    e.stopPropagation();
                }

                if (!toggleElement) return;

                // Get the target panel ID from aria-controls attribute
                const targetPanelId = toggleElement.getAttribute('aria-controls');
                if (!targetPanelId) {
                    console.warn('Accordion toggle missing aria-controls attribute');
                    return;
                }

                // Find the target panel by ID
                const targetPanel = document.getElementById(targetPanelId);
                if (!targetPanel) {
                    console.warn(`Accordion panel not found: ${targetPanelId}`);
                    return;
                }

                // Toggle the panel
                const isExpanded = targetPanel.classList.contains('expanded');

                if (isExpanded) {
                    // Close this panel only
                    targetPanel.classList.remove('expanded');
                    toggleElement.setAttribute('aria-expanded', 'false');
                } else {
                    // Open this panel only (do not close others)
                    targetPanel.classList.add('expanded');
                    toggleElement.setAttribute('aria-expanded', 'true');
                }
            };

            // Find all accordion toggles by their IDs
            const accordionToggles = [
                document.getElementById('archiveToggle'),
                document.getElementById('resourcesToggle'),
                document.getElementById('readingListToggle'),
                document.getElementById('booksToggle'),
                document.getElementById('playlistToggle'),
                document.getElementById('cinematographyToggle'),
                document.getElementById('colorgradingToggle'),
                document.getElementById('writingToggle'),
                document.getElementById('productsToggle'),
                document.getElementById('applicationsToggle'),
                document.getElementById('pluginsToggle')
            ].filter(toggle => toggle !== null); // Only include toggles that exist

            // Initialize each accordion toggle
            accordionToggles.forEach(toggle => {
                toggle.style.pointerEvents = 'auto';

                // Click handler
                toggle.addEventListener('click', (e) => {
                    toggleAccordion(toggle, e);
                }, true);

                // Keyboard handler (Enter and Space)
                toggle.addEventListener('keydown', (e) => {
                    if (e.key === 'Enter' || e.key === ' ') {
                        toggleAccordion(toggle, e);
                    }
                });
            });
        })();

        // Before/After Wipe - Mobile Optimized
        function initBeforeAfter(ba) {
          // #region agent log
          const logDataEntry = {location:'monos-pros-monon.html:initBeforeAfter',message:'Function entry',data:{baExists:!!ba,alreadyInit:!!ba?.__ba_init},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'F'};
          console.log('[DEBUG]', logDataEntry);
          fetch('http://127.0.0.1:7243/ingest/5ff05d9b-3ef1-40eb-9d6e-765460d3f675',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(logDataEntry)}).catch(()=>{});
          // #endregion
          if (!ba || ba.__ba_init) return;
          ba.__ba_init = true;

          const start = Number(ba.getAttribute("data-start") || 50);

          const clamp = (n, min, max) => Math.max(min, Math.min(max, n));
          const setPos = (pct) => ba.style.setProperty("--pos", clamp(pct, 0, 100) + "%");

          const xToPct = (clientX) => {
            const r = ba.getBoundingClientRect();
            const x = clamp(clientX - r.left, 0, r.width);
            return (x / r.width) * 100;
          };

          setPos(start);

          let dragging = false;
          ba.isDragging = false; // Expose dragging state for modal scroll prevention

          const down = (clientX) => {
            // #region agent log
            const logData1 = {location:'monos-pros-monon.html:down',message:'Down called',data:{clientX,wasDragging:dragging},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'E'};
            console.log('[DEBUG]', logData1);
            fetch('http://127.0.0.1:7243/ingest/5ff05d9b-3ef1-40eb-9d6e-765460d3f675',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(logData1)}).catch(()=>{});
            // #endregion
            dragging = true;
            ba.isDragging = true;
            const pct = xToPct(clientX);
            // #region agent log
            const logData2 = {location:'monos-pros-monon.html:down',message:'After setPos',data:{pct,nowDragging:dragging},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'E'};
            console.log('[DEBUG]', logData2);
            fetch('http://127.0.0.1:7243/ingest/5ff05d9b-3ef1-40eb-9d6e-765460d3f675',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(logData2)}).catch(()=>{});
            // #endregion
            setPos(pct);
          };

          const move = (clientX) => {
            // #region agent log
            const logData = {location:'monos-pros-monon.html:move',message:'Move called',data:{clientX,dragging},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'E'};
            console.log('[DEBUG]', logData);
            fetch('http://127.0.0.1:7243/ingest/5ff05d9b-3ef1-40eb-9d6e-765460d3f675',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(logData)}).catch(()=>{});
            // #endregion
            if (!dragging) return;
            const pct = xToPct(clientX);
            setPos(pct);
          };

          const up = () => {
            // #region agent log
            const logData = {location:'monos-pros-monon.html:up',message:'Up called',data:{wasDragging:dragging},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'E'};
            console.log('[DEBUG]', logData);
            fetch('http://127.0.0.1:7243/ingest/5ff05d9b-3ef1-40eb-9d6e-765460d3f675',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(logData)}).catch(()=>{});
            // #endregion
            dragging = false;
            ba.isDragging = false;
          };

          // Pointer Events (best when available)
          const onPointerDown = (e) => {
            // #region agent log
            const logData1 = {location:'monos-pros-monon.html:onPointerDown',message:'Pointer down event',data:{pointerId:e.pointerId,clientX:e.clientX,cancelable:e.cancelable,pointerType:e.pointerType},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'C'};
            console.log('[DEBUG]', logData1);
            fetch('http://127.0.0.1:7243/ingest/5ff05d9b-3ef1-40eb-9d6e-765460d3f675',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(logData1)}).catch(()=>{});
            // #endregion
            if (e.target.closest("a, button, input, textarea, select")) return;
            if (e.cancelable) {
              e.preventDefault();
              // #region agent log
              const logData2 = {location:'monos-pros-monon.html:onPointerDown',message:'preventDefault called',data:{},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'A'};
              console.log('[DEBUG]', logData2);
              fetch('http://127.0.0.1:7243/ingest/5ff05d9b-3ef1-40eb-9d6e-765460d3f675',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(logData2)}).catch(()=>{});
              // #endregion
            }
            const captured = ba.setPointerCapture?.(e.pointerId);
            // #region agent log
            const logData3 = {location:'monos-pros-monon.html:onPointerDown',message:'After setPointerCapture',data:{hasCapture:!!ba.hasPointerCapture?.(e.pointerId),captured:captured!==undefined},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'B'};
            console.log('[DEBUG]', logData3);
            fetch('http://127.0.0.1:7243/ingest/5ff05d9b-3ef1-40eb-9d6e-765460d3f675',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(logData3)}).catch(()=>{});
            // #endregion
            down(e.clientX);
          };

          const onPointerMove = (e) => {
            // #region agent log
            const logData1 = {location:'monos-pros-monon.html:onPointerMove',message:'Pointer move event',data:{pointerId:e.pointerId,clientX:e.clientX,hasCapture:!!ba.hasPointerCapture?.(e.pointerId),dragging},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'B'};
            console.log('[DEBUG]', logData1);
            fetch('http://127.0.0.1:7243/ingest/5ff05d9b-3ef1-40eb-9d6e-765460d3f675',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(logData1)}).catch(()=>{});
            // #endregion
            if (!ba.hasPointerCapture?.(e.pointerId) && !dragging) return;
            if (e.cancelable) {
              e.preventDefault();
              // #region agent log
              const logData2 = {location:'monos-pros-monon.html:onPointerMove',message:'preventDefault called in move',data:{},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'A'};
              console.log('[DEBUG]', logData2);
              fetch('http://127.0.0.1:7243/ingest/5ff05d9b-3ef1-40eb-9d6e-765460d3f675',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(logData2)}).catch(()=>{});
              // #endregion
            }
            move(e.clientX);
          };

          const onPointerUp = (e) => {
            // #region agent log
            const logData = {location:'monos-pros-monon.html:onPointerUp',message:'Pointer up event',data:{pointerId:e.pointerId},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'C'};
            console.log('[DEBUG]', logData);
            fetch('http://127.0.0.1:7243/ingest/5ff05d9b-3ef1-40eb-9d6e-765460d3f675',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(logData)}).catch(()=>{});
            // #endregion
            try { ba.releasePointerCapture?.(e.pointerId); } catch {}
            up();
          };

          // Touch fallback (covers iOS/modal weirdness)
          const onTouchStart = (e) => {
            // #region agent log
            const logData1 = {location:'monos-pros-monon.html:onTouchStart',message:'Touch start event',data:{touchCount:e.touches?.length,cancelable:e.cancelable,hasTouches:!!e.touches},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'C'};
            console.log('[DEBUG]', logData1);
            fetch('http://127.0.0.1:7243/ingest/5ff05d9b-3ef1-40eb-9d6e-765460d3f675',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(logData1)}).catch(()=>{});
            // #endregion
            if (e.target.closest("a, button, input, textarea, select")) return;
            if (e.cancelable) {
              e.preventDefault();
              // #region agent log
              const logData2 = {location:'monos-pros-monon.html:onTouchStart',message:'preventDefault called in touchstart',data:{},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'A'};
              console.log('[DEBUG]', logData2);
              fetch('http://127.0.0.1:7243/ingest/5ff05d9b-3ef1-40eb-9d6e-765460d3f675',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(logData2)}).catch(()=>{});
              // #endregion
            }
            const t = e.touches && e.touches[0];
            // #region agent log
            const logData3 = {location:'monos-pros-monon.html:onTouchStart',message:'Touch data check',data:{hasTouch:!!t,clientX:t?.clientX,clientY:t?.clientY},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'D'};
            console.log('[DEBUG]', logData3);
            fetch('http://127.0.0.1:7243/ingest/5ff05d9b-3ef1-40eb-9d6e-765460d3f675',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(logData3)}).catch(()=>{});
            // #endregion
            if (!t) return;
            down(t.clientX);
          };

          const onTouchMove = (e) => {
            // #region agent log
            const logData1 = {location:'monos-pros-monon.html:onTouchMove',message:'Touch move event',data:{dragging,touchCount:e.touches?.length,cancelable:e.cancelable},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'E'};
            console.log('[DEBUG]', logData1);
            fetch('http://127.0.0.1:7243/ingest/5ff05d9b-3ef1-40eb-9d6e-765460d3f675',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(logData1)}).catch(()=>{});
            // #endregion
            if (!dragging) return;
            if (e.cancelable) {
              e.preventDefault();
              // #region agent log
              const logData2 = {location:'monos-pros-monon.html:onTouchMove',message:'preventDefault called in touchmove',data:{},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'A'};
              console.log('[DEBUG]', logData2);
              fetch('http://127.0.0.1:7243/ingest/5ff05d9b-3ef1-40eb-9d6e-765460d3f675',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(logData2)}).catch(()=>{});
              // #endregion
            }
            const t = e.touches && e.touches[0];
            // #region agent log
            const logData3 = {location:'monos-pros-monon.html:onTouchMove',message:'Touch data in move',data:{hasTouch:!!t,clientX:t?.clientX},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'D'};
            console.log('[DEBUG]', logData3);
            fetch('http://127.0.0.1:7243/ingest/5ff05d9b-3ef1-40eb-9d6e-765460d3f675',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(logData3)}).catch(()=>{});
            // #endregion
            if (!t) return;
            move(t.clientX);
          };

          const onTouchEnd = () => {
            // #region agent log
            const logData = {location:'monos-pros-monon.html:onTouchEnd',message:'Touch end event',data:{},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'C'};
            console.log('[DEBUG]', logData);
            fetch('http://127.0.0.1:7243/ingest/5ff05d9b-3ef1-40eb-9d6e-765460d3f675',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(logData)}).catch(()=>{});
            // #endregion
            up();
          };

          // Attach to the whole slider area (not just the handle) for mobile friendliness
          ba.addEventListener("pointerdown", onPointerDown, { passive: false });
          ba.addEventListener("pointermove", onPointerMove, { passive: false });
          ba.addEventListener("pointerup", onPointerUp);
          ba.addEventListener("pointercancel", onPointerUp);

          ba.addEventListener("touchstart", onTouchStart, { passive: false });
          ba.addEventListener("touchmove", onTouchMove, { passive: false });
          ba.addEventListener("touchend", onTouchEnd);
          ba.addEventListener("touchcancel", onTouchEnd);
          
          // Find nearest scrollable modal ancestor and prevent scroll during drag
          const findScrollableAncestor = (el) => {
            let current = el.parentElement;
            while (current && current !== document.body) {
              const style = getComputedStyle(current);
              const overflow = style.overflow || style.overflowY || style.overflowX;
              if (overflow === 'auto' || overflow === 'scroll' || 
                  current.classList.contains('modal') || 
                  current.classList.contains('modal-content') ||
                  current.getAttribute('role') === 'dialog' ||
                  current.classList.contains('monos-container') ||
                  current.classList.contains('monos-section')) {
                return current;
              }
              current = current.parentElement;
            }
            return document.body; // Fallback to body
          };

          const scrollContainer = findScrollableAncestor(ba);
          
          // Prevent modal scroll during slider drag (Safari mobile fix)
          const preventModalScroll = (e) => {
            if (ba.isDragging && e.cancelable) {
              e.preventDefault();
            }
          };
          
          scrollContainer.addEventListener('touchmove', preventModalScroll, { passive: false });
          
          // Clean up on slider removal (if needed)
          ba._scrollPreventHandler = preventModalScroll;
          ba._scrollContainer = scrollContainer;
          
          // #region agent log
          const logDataListeners = {location:'monos-pros-monon.html:initBeforeAfter',message:'Event listeners attached',data:{hasBa:!!ba,scrollContainer:scrollContainer?.className || scrollContainer?.tagName},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'F'};
          console.log('[DEBUG]', logDataListeners);
          fetch('http://127.0.0.1:7243/ingest/5ff05d9b-3ef1-40eb-9d6e-765460d3f675',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(logDataListeners)}).catch(()=>{});
          // #endregion

          // Optional: keyboard support
          const handle = ba.querySelector('.ba__handle');
          if (handle) {
            handle.addEventListener('keydown', (e) => {
              const current = parseFloat(getComputedStyle(ba).getPropertyValue('--pos')) || start;
              if (e.key === 'ArrowLeft') {
                e.preventDefault();
                setPos(current - 2);
              }
              if (e.key === 'ArrowRight') {
                e.preventDefault();
                setPos(current + 2);
              }
            });
          }
        }

        // Initialize all sliders on page load
        function initAllBeforeAfter() {
          // #region agent log
          const logData1 = {location:'monos-pros-monon.html:initAllBeforeAfter',message:'Init function called',data:{readyState:document.readyState},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'F'};
          console.log('[DEBUG]', logData1);
          fetch('http://127.0.0.1:7243/ingest/5ff05d9b-3ef1-40eb-9d6e-765460d3f675',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(logData1)}).catch(()=>{});
          // #endregion
          const sliders = document.querySelectorAll(".ba");
          // #region agent log
          const logData2 = {location:'monos-pros-monon.html:initAllBeforeAfter',message:'Sliders found',data:{count:sliders.length},timestamp:Date.now(),sessionId:'debug-session',runId:'run1',hypothesisId:'F'};
          console.log('[DEBUG]', logData2);
          fetch('http://127.0.0.1:7243/ingest/5ff05d9b-3ef1-40eb-9d6e-765460d3f675',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify(logData2)}).catch(()=>{});
          // #endregion
          sliders.forEach(initBeforeAfter);
        }

        // Initialize when DOM is ready
        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', initAllBeforeAfter);
        } else {
          initAllBeforeAfter();
        }
    </script>

    <!-- Liquid Glass SVG Filter -->
    <svg xmlns="http://www.w3.org/2000/svg" width="0" height="0" style="position:absolute; overflow:hidden">
        <defs>
            <filter id="glass-distortion" x="0%" y="0%" width="100%" height="100%">
                <feTurbulence type="fractalNoise" baseFrequency="0.008 0.008" numOctaves="2" seed="92" result="noise" />
                <feGaussianBlur in="noise" stdDeviation="2" result="blurred" />
                <feDisplacementMap in="SourceGraphic" in2="blurred" scale="77" xChannelSelector="R" yChannelSelector="G" />
            </filter>
        </defs>
    </svg>
</body>
</html>

