<!DOCTYPE html>
<html lang="en">
<head>
    <!-- Google tag (gtag.js) -->
    <script async src="https://www.googletagmanager.com/gtag/js?id=G-NKXE9654HJ"></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('js', new Date());

      gtag('config', 'G-NKXE9654HJ');
    </script>
    
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <meta name="robots" content="noindex, nofollow">
    <title>Monos Pros Monon</title>
    
    <!-- Favicon -->
    
    <link rel="icon" type="image/x-icon" href="Images/icons/icon.ico?v=3">
    <link rel="icon" type="image/png" sizes="16x16" href="Images/icons/icon-16x16.png?v=3">
    <link rel="icon" type="image/png" sizes="32x32" href="Images/icons/icon-32x32.png?v=3">
    <link rel="apple-touch-icon" sizes="180x180" href="Images/icons/apple-icon.png?v=3">
    <style>
        :root {
            /* Liquid Glass Variables */
            --lg-shadow-blur: 10px;
            --lg-shadow-spread: -6px;
            --lg-shadow-color: rgba(255, 255, 255, 0.4);
            --lg-tint-color: 255, 255, 255;
            --lg-tint-opacity: 0.04;
            --lg-frost-blur: 2px;
            --lg-noise-frequency: 0.008;
            --lg-distortion-strength: 77;
            --lg-outer-shadow-blur: 24px;
            --lg-border-color: rgba(255, 255, 255, 0.25);
            --lg-border-width: 0.5px;
        }

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html {
            scroll-behavior: smooth;
        }

        body {
            font-family: 'Times New Roman', Times, serif;
            font-weight: 400;
            background: #0a0a0a;
            color: #cccccc;
            font-size: 11px;
            line-height: 1.5;
            letter-spacing: 0.5px;
            text-transform: uppercase;
            padding: 0;
            margin: 0;
        }

        .monos-container {
            max-width: 800px;
            min-width: 300px;
            width: 100%;
            margin: 0 auto;
            text-align: center;
            box-sizing: border-box;
        }

        .monos-logo {
            width: 30%;
            max-width: 300px;
            height: auto;
            min-height: 180px;
            object-fit: contain;
            margin: 2rem auto 0.5rem auto;
            display: block;
        }

        .monos-section {
            margin-bottom: 3rem;
            text-align: center;
        }

        .monos-section h2 {
            font-family: 'Times New Roman', Times, serif;
            font-size: 0.75rem;
            font-weight: 400;
            color: #cccccc;
            margin: 0 auto 2rem auto;
            letter-spacing: 0.2em;
            text-align: center;
            padding: 5px 16px;
            background: transparent;
            border: none;
            border-radius: 20px;
            display: inline-block;
            width: auto;
            position: relative;
            isolation: isolate;
            box-shadow: 0px 6px var(--lg-outer-shadow-blur) rgba(0, 0, 0, 0.2);
        }

        .monos-section h2::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: 0;
            border-radius: 20px;
            box-shadow: inset 0 0 var(--lg-shadow-blur) var(--lg-shadow-spread) var(--lg-shadow-color);
            background-color: rgba(var(--lg-tint-color), var(--lg-tint-opacity));
            border: var(--lg-border-width) solid var(--lg-border-color);
            pointer-events: none;
        }

        .monos-section h2::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            border-radius: 20px;
            backdrop-filter: blur(var(--lg-frost-blur));
            filter: url(#glass-distortion);
            isolation: isolate;
            -webkit-backdrop-filter: blur(var(--lg-frost-blur));
            -webkit-filter: url("#glass-distortion");
        }

        .monos-section h2:hover {
            color: #ffffff;
            box-shadow: 0px 6px calc(var(--lg-outer-shadow-blur) + 2px) rgba(0, 0, 0, 0.25);
        }

        .monos-section h2:hover::before {
            box-shadow: inset 0 0 calc(var(--lg-shadow-blur) + 2px) var(--lg-shadow-spread) var(--lg-shadow-color);
        }

        .monos-items {
            display: flex;
            flex-direction: column;
            gap: 1rem;
            align-items: center;
        }

        .monos-item {
            font-family: 'Times New Roman', Times, serif;
            font-size: 0.9rem;
            font-weight: 400;
            color: #cccccc;
            text-decoration: none;
            padding: 8px 0;
            background: none;
            border: none;
            border-radius: 0;
            transition: none;
            display: block;
            text-align: center;
        }

        .monos-item em {
            font-style: italic;
        }

        .monos-description {
            font-family: 'Times New Roman', Times, serif;
            font-size: 0.85rem;
            font-weight: 400;
            font-style: italic;
            color: #cccccc;
            text-align: left;
            margin: 0.5rem auto 1.5rem auto;
            max-width: 600px;
            line-height: 1.6;
            letter-spacing: 0.3px;
            text-transform: none;
            padding: 0 1rem;
        }

        .monos-divider {
            width: 100%;
            max-width: 600px;
            height: 1px;
            background: rgba(255, 255, 255, 0.15);
            margin: 2rem auto;
            border: none;
        }

        .plugins-content {
            max-height: 0;
            overflow: hidden;
            opacity: 0;
            transition: max-height 0.3s cubic-bezier(0, 1, 0, 1), opacity 0.2s ease-out;
        }

        .plugins-content.expanded {
            max-height: 10000px;
            opacity: 1;
            transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease-in;
        }

        .applications-content {
            max-height: 0;
            overflow: hidden;
            opacity: 0;
            transition: max-height 0.3s cubic-bezier(0, 1, 0, 1), opacity 0.2s ease-out;
        }

        .applications-content.expanded {
            max-height: 10000px;
            opacity: 1;
            transition: max-height 0.5s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.3s ease-in;
        }

        #resourcesToggle,
        #productsToggle,
        #applicationsToggle,
        #pluginsToggle {
            pointer-events: auto;
            position: relative;
            z-index: 10;
            cursor: pointer;
            isolation: isolate;
            box-shadow: 0px 6px var(--lg-outer-shadow-blur) rgba(0, 0, 0, 0.2);
            background: transparent !important;
            backdrop-filter: none !important;
            -webkit-backdrop-filter: none !important;
        }

        #resourcesToggle::before,
        #productsToggle::before,
        #applicationsToggle::before,
        #pluginsToggle::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: 0;
            border-radius: 20px;
            box-shadow: inset 0 0 var(--lg-shadow-blur) var(--lg-shadow-spread) var(--lg-shadow-color);
            background-color: rgba(var(--lg-tint-color), var(--lg-tint-opacity));
            border: var(--lg-border-width) solid var(--lg-border-color);
            pointer-events: none;
        }

        #resourcesToggle::after,
        #productsToggle::after,
        #applicationsToggle::after,
        #pluginsToggle::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            border-radius: 20px;
            backdrop-filter: blur(var(--lg-frost-blur));
            filter: url(#glass-distortion);
            isolation: isolate;
            -webkit-backdrop-filter: blur(var(--lg-frost-blur));
            -webkit-filter: url("#glass-distortion");
        }

        #resourcesToggle:hover,
        #productsToggle:hover,
        #applicationsToggle:hover,
        #pluginsToggle:hover {
            color: #ffffff;
            box-shadow: 0px 6px calc(var(--lg-outer-shadow-blur) + 2px) rgba(0, 0, 0, 0.25);
        }

        #resourcesToggle:hover::before,
        #productsToggle:hover::before,
        #applicationsToggle:hover::before,
        #pluginsToggle:hover::before {
            box-shadow: inset 0 0 calc(var(--lg-shadow-blur) + 2px) var(--lg-shadow-spread) var(--lg-shadow-color);
        }

        /* Nested pill styling */
        .nested-pill {
            position: relative;
            isolation: isolate;
            box-shadow: 0px 4px calc(var(--lg-outer-shadow-blur) * 0.7) rgba(0, 0, 0, 0.15);
            background: transparent !important;
            border-radius: 20px;
            font-family: 'Times New Roman', Times, serif;
            font-weight: 400;
            color: #cccccc;
            letter-spacing: 0.2em;
            transition: all 0.2s ease;
        }

        .nested-pill::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: 0;
            border-radius: 20px;
            box-shadow: inset 0 0 calc(var(--lg-shadow-blur) * 0.8) var(--lg-shadow-spread) rgba(255, 255, 255, 0.3);
            background-color: rgba(var(--lg-tint-color), 0.03);
            border: var(--lg-border-width) solid rgba(255, 255, 255, 0.18);
            pointer-events: none;
        }

        .nested-pill::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            border-radius: 20px;
            backdrop-filter: blur(calc(var(--lg-frost-blur) * 0.8));
            -webkit-backdrop-filter: blur(calc(var(--lg-frost-blur) * 0.8));
        }

        .nested-pill:hover {
            opacity: 1 !important;
            color: #ffffff;
        }

        /* Liquid Glass Buy Button */
        .lg-pill {
            font-family: 'Times New Roman', Times, serif;
            font-size: 1rem;
            font-weight: 400;
            color: #cccccc;
            letter-spacing: 0.2em;
            text-align: center;
            padding: 5px 16px;
            background: transparent;
            border: none;
            border-radius: 20px;
            display: inline-block;
            text-decoration: none;
            position: relative;
            isolation: isolate;
            box-shadow: 0px 6px var(--lg-outer-shadow-blur) rgba(0, 0, 0, 0.2);
            transition: all 0.3s ease;
        }

        .lg-pill::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: 0;
            border-radius: 20px;
            box-shadow: inset 0 0 var(--lg-shadow-blur) var(--lg-shadow-spread) var(--lg-shadow-color);
            background-color: rgba(var(--lg-tint-color), var(--lg-tint-opacity));
            border: var(--lg-border-width) solid var(--lg-border-color);
            pointer-events: none;
        }

        .lg-pill::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            border-radius: 20px;
            backdrop-filter: blur(var(--lg-frost-blur));
            filter: url(#glass-distortion);
            isolation: isolate;
            -webkit-backdrop-filter: blur(var(--lg-frost-blur));
            -webkit-filter: url("#glass-distortion");
        }

        .lg-pill:hover {
            color: #ffffff;
            box-shadow: 0px 6px calc(var(--lg-outer-shadow-blur) + 2px) rgba(0, 0, 0, 0.25);
        }

        .lg-pill:hover::before {
            box-shadow: inset 0 0 calc(var(--lg-shadow-blur) + 2px) var(--lg-shadow-spread) var(--lg-shadow-color);
        }

        .monos-footer {
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 0.75rem;
            margin: 2rem auto 2rem auto;
            padding: 0 1rem;
        }

        .monos-footer-icons {
            display: flex;
            gap: 0.75rem;
            align-items: center;
            justify-content: center;
        }

        .monos-footer-icon {
            width: 36px;
            height: 36px;
            display: flex;
            align-items: center;
            justify-content: center;
            position: relative;
            border-radius: 10px;
            isolation: isolate;
            box-shadow: 0px 4px var(--lg-outer-shadow-blur) rgba(0, 0, 0, 0.2);
            transition: all 0.3s ease;
            text-decoration: none;
        }

        .monos-footer-icon::before {
            content: '';
            position: absolute;
            inset: 0;
            z-index: 0;
            border-radius: 10px;
            box-shadow: inset 0 0 var(--lg-shadow-blur) var(--lg-shadow-spread) var(--lg-shadow-color);
            background-color: rgba(var(--lg-tint-color), var(--lg-tint-opacity));
            border: var(--lg-border-width) solid var(--lg-border-color);
            pointer-events: none;
        }

        .monos-footer-icon::after {
            content: '';
            position: absolute;
            inset: 0;
            z-index: -1;
            border-radius: 10px;
            backdrop-filter: blur(var(--lg-frost-blur));
            filter: url(#glass-distortion);
            isolation: isolate;
            -webkit-backdrop-filter: blur(var(--lg-frost-blur));
            -webkit-filter: url("#glass-distortion");
        }

        .monos-footer-icon:hover {
            box-shadow: 0px 6px calc(var(--lg-outer-shadow-blur) + 2px) rgba(0, 0, 0, 0.25);
        }

        .monos-footer-icon svg {
            width: 16px;
            height: 16px;
            fill: #888888;
            position: relative;
            z-index: 1;
        }

        .monos-copyright {
            font-family: 'Times New Roman', Times, serif;
            font-size: 0.7rem;
            color: rgba(255, 255, 255, 0.5);
            text-align: center;
            margin-top: 0;
            margin-bottom: 0;
            padding-bottom: 1rem;
        }

        .monos-image-container {
            display: flex;
            flex-direction: column;
            gap: 2rem;
            margin: 2rem auto;
            max-width: 800px;
            min-width: 300px;
            width: 100%;
            padding: 0 1rem;
            box-sizing: border-box;
            overscroll-behavior: contain;
            -webkit-overflow-scrolling: touch;
        }

        .monos-image-pair {
            display: flex;
            flex-direction: column;
            gap: 0.5rem;
            width: 100%;
            min-width: 0;
            box-sizing: border-box;
            flex-shrink: 0;
        }

        .monos-image-label {
            font-family: 'Times New Roman', Times, serif;
            font-size: 0.8rem;
            font-weight: 400;
            color: #cccccc;
            text-align: center;
            letter-spacing: 0.2em;
            text-transform: uppercase;
            margin-bottom: 0.25rem;
        }

        .monos-image {
            width: 100%;
            max-width: 100%;
            min-width: 200px;
            height: auto;
            min-height: 100px;
            display: block !important;
            visibility: visible !important;
            opacity: 1 !important;
            border-radius: 4px;
            object-fit: contain;
            margin: 0 auto;
            position: relative;
            z-index: 1;
            flex-shrink: 0;
        }


        .monos-package {
            margin: 0 auto 1.5rem auto;
        }

        .monos-package-title {
            font-family: 'Times New Roman', Times, serif;
            font-size: 0.9rem;
            font-weight: 400;
            color: #cccccc;
            text-decoration: none;
            padding: 8px 0;
            background: none;
            border: none;
            border-radius: 0;
            transition: none;
            display: block;
            text-align: center;
            margin: 0 auto;
        }

        .monos-package-description {
            font-family: 'Times New Roman', Times, serif;
            font-size: 0.85rem;
            font-weight: 400;
            font-style: italic;
            color: #cccccc;
            text-align: center;
            margin: 0.5rem auto;
            line-height: 1.5;
            letter-spacing: 0.3px;
            text-transform: none;
        }

        .monos-package-price {
            font-family: 'Times New Roman', Times, serif;
            font-size: 0.9rem;
            font-weight: 400;
            font-style: italic;
            color: #cccccc;
            text-align: center;
            margin: 0.5rem auto;
            letter-spacing: 0.2em;
            text-decoration: underline;
            cursor: pointer;
            transition: color 0.2s ease;
        }

        .monos-package-price:hover {
            color: #ffffff;
        }

        .monos-package-price a {
            color: inherit;
            text-decoration: inherit;
        }

        .monos-checkout-link {
            font-family: 'Times New Roman', Times, serif;
            font-size: 0.85rem;
            font-weight: 400;
            color: #cccccc;
            text-align: center;
            text-decoration: underline;
            display: block;
            margin: 0.75rem auto;
            transition: color 0.2s ease;
        }

        .monos-checkout-link:hover {
            color: #ffffff;
        }

        .monos-company {
            font-family: 'Times New Roman', Times, serif;
            font-size: 0.9rem;
            font-weight: 400;
            color: #cccccc;
            text-align: center;
            margin: 0 auto 2rem auto;
            line-height: 1.5;
            letter-spacing: 0.5px;
            text-transform: none;
            font-style: italic;
            margin-top: 0;
        }

        /* Mobile font size reduction */
        @media (max-width: 600px) {
            body {
                font-size: 9px !important;
                padding: 1rem 1rem 0.5rem 1rem !important;
            }

            .monos-logo {
                width: 65% !important;
                max-width: 65% !important;
                min-height: 120px !important;
                margin: 1.5rem auto 1rem auto !important;
            }

            .monos-section {
                margin-bottom: 1.5rem !important;
            }

            .monos-section:last-child {
                margin-bottom: 0 !important;
            }

            .monos-items {
                flex-direction: column !important;
                gap: 0.5rem !important;
                align-items: center !important;
            }

            .monos-item {
                font-size: 0.75rem !important;
                display: block !important;
                width: 100% !important;
                text-align: center !important;
            }

            .monos-section h2 {
                font-size: 10px !important;
                padding: 4px 12px !important;
                display: inline-block !important;
                width: auto !important;
                margin: 0.75rem auto !important;
            }
            
            .monos-section a[href*="buy.stripe"] {
                font-size: 10px !important;
                padding: 4px 12px !important;
            }

            .monos-items h2 {
                margin: 0.75rem auto 0.5rem auto !important;
            }

            .monos-items h2 {
                font-size: 10px !important;
                padding: 4px 12px !important;
                display: inline-block !important;
                width: auto !important;
                margin: 0.75rem auto !important;
            }

            .monos-company {
                font-size: 0.85rem !important;
                margin: 0 auto 1rem auto !important;
            }

            .monos-description {
                font-size: 0.75rem !important;
                margin: 0.5rem auto 1rem auto !important;
                padding: 0 0.5rem !important;
            }

            .monos-image-container {
                gap: 1.5rem !important;
                margin: 1.5rem auto !important;
                padding: 0 0.5rem !important;
                width: 100% !important;
                max-width: 100% !important;
                display: flex !important;
                flex-direction: column !important;
            }

            .monos-image-pair {
                width: 100% !important;
                max-width: 100% !important;
                display: flex !important;
                flex-direction: column !important;
            }

            .monos-image {
                width: 100% !important;
                max-width: 100% !important;
                height: auto !important;
                display: block !important;
                visibility: visible !important;
                opacity: 1 !important;
                position: relative !important;
                z-index: 1 !important;
                margin: 0 auto !important;
                box-sizing: border-box !important;
            }

            .monos-image-label {
                font-size: 0.7rem !important;
            }

            .image-slider-container {
                margin: 0 auto !important;
            }

            .image-slider-wrapper {
                padding-bottom: 66.67% !important;
            }

            .image-slider-buttons {
                gap: 0.75rem !important;
                margin-top: 0.5rem !important;
            }

            .image-slider-btn {
                font-size: 0.7rem !important;
                padding: 0.2rem 0.5rem !important;
            }

            .monos-package {
                margin: 0.5rem auto 0 auto !important;
            }

            .monos-package-title {
                font-size: 0.75rem !important;
            }

            .monos-package-description {
                font-size: 0.75rem !important;
            }

            .monos-package-price {
                font-size: 0.8rem !important;
            }

            .monos-checkout-link {
                font-size: 0.75rem !important;
            }

            #productsToggle {
                margin-bottom: 1.75rem !important;
            }

            .monos-copyright {
                margin-top: 0.5rem !important;
                margin-bottom: 0 !important;
                padding-bottom: 0.5rem !important;
            }
        }
        /* Before/After Wipe */
        /* Put these on the slider container + handle */
        .ba,
        .ba * {
          -webkit-user-select: none;
          user-select: none;
        }

        .ba {
          position: relative;
          width: 100%;
          max-width: 1100px;
          margin: 0 auto;
          aspect-ratio: 16 / 9;
          overflow: hidden;
          border-radius: 16px;
          --pos: 50%;
          touch-action: none;              /* key */
          -webkit-touch-callout: none;
          -webkit-user-drag: none;
        }

        .ba__img {
          position: absolute;
          inset: 0;
          width: 100%;
          height: 100%;
          object-fit: cover;
          pointer-events: none;
          -webkit-user-drag: none;
        }

        .ba__after {
          position: absolute;
          inset: 0;
          clip-path: inset(0 0 0 var(--pos));
        }

        .ba__divider {
          position: absolute;
          top: 0;
          bottom: 0;
          left: var(--pos);
          width: 2px;
          transform: translateX(-1px);
          background: rgba(255, 255, 255, 0.6);
          backdrop-filter: blur(6px);
          -webkit-backdrop-filter: blur(6px);
          pointer-events: none;
        }

        .ba__handle {
          position: absolute;
          top: 50%;
          left: var(--pos);
          transform: translate(-50%, -50%);
          cursor: ew-resize;
          touch-action: none;              /* key */
        }

        /* skinnier pill */
        .ba__pill {
          display: inline-grid;
          grid-auto-flow: column;
          place-items: center;
          column-gap: 10px;
          height: 22px;
          padding: 0 8px;          /* vertical padding removed */
          border-radius: 999px;
          background: rgba(255, 255, 255, 0.12);
          border: 1px solid rgba(255, 255, 255, 0.18);
          backdrop-filter: blur(10px);
          -webkit-backdrop-filter: blur(10px);
          box-shadow: 0 8px 30px rgba(0, 0, 0, 0.18);
        }

        .ba__chev {
          display: block;
          font-size: 16px;
          line-height: 1;
          color: rgba(255, 255, 255, 0.9);
          transform: translateY(-1px); /* optical correction */
        }

        @media (max-width: 420px) {
          .ba__pill {
            padding: 0 7px;
            height: 22px;
          }
          .ba__chev {
            font-size: 15px;
          }
        }
    </style>
</head>
<body>
    <div class="monos-container">
        <img src="Images/Logos/monos-logo-transparent.png" alt="Monos Pros Monon" class="monos-logo">
        
        <p class="monos-company">a company</p>
        <hr class="monos-divider" style="margin-top: 1.5rem; margin-bottom: 3rem;">
        <div class="monos-section" style="margin-bottom: 2.5rem;">
            <h2 id="resourcesToggle" style="margin: 0 auto 1rem auto; cursor: pointer;" role="button" aria-expanded="false" aria-controls="resources-panel" tabindex="0">RESOURCES</h2>
            <div class="plugins-content" id="resources-panel">
