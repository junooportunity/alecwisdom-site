                    <h2 id="applicationsToggle" class="nested-pill" style="margin: 0; cursor: pointer; font-size: 0.65rem; padding: 4px 14px; opacity: 0.85;" role="button" aria-expanded="false" aria-controls="applications-panel" tabindex="0">APPLICATIONS</h2>
